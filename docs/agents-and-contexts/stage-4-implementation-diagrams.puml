@startuml stage-4-implementation-diagrams
title Stage 4 — Implementation Diagrams  (post-implementation resume)\nMain context vs. the implementation-analyst sub-agent

skinparam defaultFontName "Helvetica"
skinparam shadowing false
skinparam rectangleBorderColor #888888
skinparam ArrowColor #555555

legend top left
  |<#FFF3CD>| Main-agent context |
  |<#D6EAF8>| Fresh sub-agent context |
  |<#E8DAEF>| Persisted artifact store (disk) |
  |<#D4EDDA>| Written this stage |
  |<#FADBD8>| Return summary read by main |
endlegend

package "Persisted artifact store" #E8DAEF {
  artifact "progress.md (active block,\n base-commit recorded)" as PROG
  artifact "git history  base-commit..HEAD" as GIT
  artifact "blueprints/current/requirements.md" as REQ
  artifact "blueprints/current/diagrams/*.puml\n(used as the seed set)" as BDIA
  artifact "project codebase" as CODE
}

package "MAIN AGENT context" #FFF3CD {
  rectangle "Loaded directly:\n• progress.md — active block\n• diff metadata (changed-file list)\n\nDelegates the heavy diff-reading and\ndiagram rendering to a fresh sub-agent." as MAIN
}

package "Sub-agent: implementation-analyst\n(model: opus · tools: Read,Write,Edit,Bash,Grep,PlantUML MCP)" #D6EAF8 {
  rectangle "Injected context:\n• base-commit..HEAD diff hunks\n• bounded context reads of changed code\n• blueprints/current/diagrams/*.puml (seed)\n• requirements.md (to detect deviations)\n\nWrites: implementation/change-summary.md\n        + re-renders affected implementation/diagrams/*.puml\n        (blue = existing @ base-commit, green = new)" as IA
}

package "Written this stage" #D4EDDA {
  artifact "implementation/change-summary.md" as CS
  artifact "implementation/diagrams/*.puml" as IDIA
}

PROG --> MAIN
GIT --> MAIN : changed-file metadata

MAIN --> IA : spawn
GIT --> IA : diff hunks
CODE --> IA : bounded reads
BDIA --> IA : seed diagrams
REQ --> IA : deviation check
IA --> CS
IA --> IDIA
IA --> MAIN : change-summary path + diagram paths\n+ drift findings / risks #FADBD8

note bottom of MAIN
  Inspector answers the drift-check prompt
  ("continue" or a reason), then proceeds to Stage 5.
end note
@enduml
