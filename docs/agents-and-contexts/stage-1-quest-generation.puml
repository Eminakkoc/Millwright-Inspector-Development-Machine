@startuml stage-1-quest-generation
title Stage 1 — Quest Generation  (/mi-run)\nWhat lives in main context vs. the digester sub-agents

skinparam defaultFontName "Helvetica"
skinparam shadowing false
skinparam rectangleBorderColor #888888
skinparam ArrowColor #555555

legend top left
  |<#FFF3CD>| Main-agent context |
  |<#D6EAF8>| Fresh sub-agent context |
  |<#E8DAEF>| Persisted artifact store (disk) |
  |<#D4EDDA>| Written this stage |
  |<#FADBD8>| Return summary read by main |
endlegend

package "Persisted artifact store" #E8DAEF {
  artifact "journal/<topic-A>/*.md" as JA
  artifact "journal/<topic-B>/*.md\n(may contain >100KB files)" as JB
  artifact "templates/*.tmpl" as TPL
}

package "MAIN AGENT context" #FFF3CD {
  rectangle "Loaded directly:\n• journal/<topic>/ files <=100KB\n• artifact templates\n\nNOT loaded: codebase (never read at stage 1)" as MAIN
}

package "Sub-agent: journal-file-digester\n(model: haiku · tools: Read)\nspawned only when a single file >100KB" #D6EAF8 {
  rectangle "Injected context:\n• ONE oversized .md/.txt file\n  (named in spawn prompt)\nOutput: digest in return message (no file write)" as FD
}

package "Sub-agent: journal-folder-digester\n(model: haiku · tools: Read,Write,Bash,Grep)\nspawned when a folder has >5 files AND >40KB" #D6EAF8 {
  rectangle "Injected context:\n• one whole journal folder\n  (excludes *.images/)\nOutput: writes .scratch/folder-digest-<folder>.md" as FoD
}

package "Written this stage — quest/<YYYY-MM-DD-slug>/" #D4EDDA {
  artifact "todo-list.md\n(one item per journal bullet)" as TODO
  artifact "summary.md\n(feature-indexed digest)" as SUM
  artifact "progress.md\n(central workflow state)" as PROG
  artifact "reference.md\n(journal-refs ID links)" as REF
}

JA --> MAIN : read (small)
TPL --> MAIN : read
JB --> FD : inject oversized file
JB --> FoD : inject oversized folder
MAIN --> FD : spawn
MAIN --> FoD : spawn
FD --> MAIN : per-file digest #FADBD8
FoD --> MAIN : path to folder-digest #FADBD8

MAIN --> TODO
MAIN --> SUM
MAIN --> PROG
MAIN --> REF
JA ..> REF : folder ID recorded in journal-refs
@enduml
